# AI Job Finder - Environment Configuration Template
# Copy this file to .env and configure the values for your environment.

# --- Environment ---
NODE_ENV=development
ENVIRONMENT=development

# --- Backend Configuration ---
SECRET_KEY=your-super-secret-key-change-this-in-production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# --- Database (PostgreSQL) ---
POSTGRES_USER=ai_job_finder
POSTGRES_PASSWORD=strong_db_password_here
POSTGRES_DB=ai_job_finder
# Local development format: postgresql://user:password@db:5432/dbname
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# --- Redis Configuration ---
REDIS_PASSWORD=strong_redis_password_here
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# --- External Services ---
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# --- Email (SMTP) ---
EMAIL=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
RECEIVER_EMAIL=receiver_email@example.com

# --- Social Auth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
