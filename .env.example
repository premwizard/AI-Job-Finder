# ==========================================
# Crown Atlas - Production Environment Variables
# ==========================================
# Do NOT place real secrets in this file.
# Copy this file to `.env` in the root, and configure in Vercel/Render.

# ------------------------------------------
# Frontend Variables (Vercel)
# ------------------------------------------
NEXT_PUBLIC_API_URL=https://api.aijobfinder.com
NEXT_PUBLIC_APP_URL=https://aijobfinder.com
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# ------------------------------------------
# Backend Variables (Render)
# ------------------------------------------
ENVIRONMENT=production
PORT=8000
CORS_ORIGINS=https://aijobfinder.com,https://www.aijobfinder.com
TRUST_PROXIES=*
LOG_LEVEL=INFO

# ------------------------------------------
# Database
# ------------------------------------------
DATABASE_URL=postgresql://user:password@hostname:5432/aijobfinder
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ------------------------------------------
# Redis / Queues / Cache
# ------------------------------------------
REDIS_URL=redis://user:password@hostname:6379/0

# ------------------------------------------
# Security & Auth
# ------------------------------------------
SECRET_KEY=generate_a_strong_random_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ------------------------------------------
# AI Providers
# ------------------------------------------
OPENAI_API_KEY=sk-your_openai_api_key
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key

# ------------------------------------------
# Object Storage (e.g. AWS S3)
# ------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=aijobfinder-prod-uploads

# ------------------------------------------
# Billing (Stripe)
# ------------------------------------------
STRIPE_SECRET_KEY=sk_live_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ------------------------------------------
# Observability
# ------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otel-collector:4317
